{
  "extends": "@beastly-brawl-showdown/configs/tsconfig",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "sourceMap": true,
    "jsx": "react"
  },
  "include": [
    "src",
  ],
  "references": [
    {
      "path": "../host"
    },
    {
      "path": "../../visualiser"
    },
  ]
}