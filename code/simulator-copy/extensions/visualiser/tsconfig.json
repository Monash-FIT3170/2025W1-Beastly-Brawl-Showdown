{
    // "extends": "@beastly-brawl-showdown/configs/tsconfig",
    "compilerOptions": {
        "esModuleInterop": true,
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "Bundler",
        "declaration": true,
        "emitDeclarationOnly": false,
        "composite": true,
        "outDir": "dist",
        "rootDir": "src",
        "sourceMap": true,
        "jsx": "react",
        "exactOptionalPropertyTypes": false // react router needs this
    },
    "include": [
        "src"
    ],
    "references": [
        {
            "path": "../../core"
        },
        {
            "path": "../../data"
        },
    ]
}